{
  "name": "react-router-next-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @evolonix/react-router-next && npm run build -w demo",
    "dev": "concurrently -n pkg,demo -c blue,green \"npm run dev -w @evolonix/react-router-next\" \"npm run dev -w demo\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck -w @evolonix/react-router-next",
    "test": "npm run test -w @evolonix/react-router-next",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build -w @evolonix/react-router-next && changeset publish",
    "commit": "cz",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write",
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "vitest": "^4.1.6"
  }
}
