{
  "name": "eslint-plugin-react-router-next",
  "version": "0.0.0",
  "description": "ESLint rules for @evolonix/react-router-next filesystem-routing conventions.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evolonix/react-router-next.git",
    "directory": "packages/eslint-plugin-react-router-next"
  },
  "bugs": {
    "url": "https://github.com/evolonix/react-router-next/issues"
  },
  "homepage": "https://evolonix.com/react-router-next",
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "eslint": "^9.18.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react-router",
    "filesystem-routing",
    "nextjs"
  ]
}
