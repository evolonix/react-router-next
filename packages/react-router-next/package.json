{
  "name": "@evolonix/react-router-next",
  "version": "3.6.0",
  "description": "Next.js-style filesystem routing for React Router 7, with a Vite plugin that generates per-route typed params.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "react-router-next": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./vite-client": {
      "types": "./dist/vite-client.d.ts",
      "import": "./dist/vite-client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evolonix/react-router-next.git",
    "directory": "packages/react-router-next"
  },
  "bugs": {
    "url": "https://github.com/evolonix/react-router-next/issues"
  },
  "homepage": "https://evolonix.com/react-router-next",
  "peerDependencies": {
    "chokidar": "^5.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "tsup": "^8.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "react",
    "react-router",
    "router",
    "filesystem-routing",
    "app-router",
    "nextjs",
    "vite",
    "vite-plugin",
    "typegen"
  ]
}
