{
  "name": "create-react-router-next",
  "version": "0.1.1",
  "description": "Scaffold a new React Router 7 app with Next.js-style filesystem routing (@evolonix/react-router-next).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-react-router-next": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evolonix/react-router-next.git",
    "directory": "packages/create-react-router-next"
  },
  "bugs": {
    "url": "https://github.com/evolonix/react-router-next/issues"
  },
  "homepage": "https://evolonix.com/react-router-next",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "react",
    "react-router",
    "filesystem-routing",
    "app-router",
    "nextjs",
    "scaffold",
    "create",
    "starter",
    "template"
  ]
}
